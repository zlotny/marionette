    <string name="instructions_send_body">Reglas cortas y genéricas para que el modelo actúe como asistente de voz. Puedes leerlas y editarlas en Ajustes, Instrucciones.</string>
    <string name="instructions_name_hint">{{name}} se sustituye por el nombre de tu agente.</string>
